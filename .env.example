# Copiez ce fichier en ".env" (install.bat le fait pour vous) puis remplissez-le.
# Ce fichier reste sur VOTRE PC : il est ignoré par git et n'est jamais envoyé nulle part.
#
# Tout est OPTIONNEL : si votre terminal MT5 est ouvert et déjà connecté à votre compte,
# laissez tout vide, la plateforme utilisera ce compte.

# Numéro de compte MT5
MT5_LOGIN=
# Mot de passe (principal pour trader, ou investisseur pour la recherche uniquement)
MT5_PASSWORD=
# Nom EXACT du serveur, tel qu'affiché dans MT5 (ex. ICMarketsSC-Demo)
MT5_SERVER=
# Seulement si plusieurs MT5 sont installés : chemin vers terminal64.exe
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
